{
  "manifest_version": 3,
  "name": "Porthole",
  "version": "1.0.0",
  "description": "Let your AI coding agent see the tabs you choose. Per-tab opt-in, read-only by default, nothing leaves your machine.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/vijaysingh/porthole",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Porthole",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
